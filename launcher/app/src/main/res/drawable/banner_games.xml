<?xml version="1.0" encoding="utf-8"?>
<!-- The Games tile: a controller on a purple-to-blue glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="315" android:startColor="#FF7B5CFA" android:endColor="#FF2C55E8" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp" android:drawable="@drawable/ic_games" />
</layer-list>
