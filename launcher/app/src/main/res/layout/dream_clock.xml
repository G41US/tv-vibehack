<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): the Home wallpaper drifting slowly, darkened, with the time, date,
     weather and what's playing in a corner that changes every few minutes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0" />

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/dreamShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dreamGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:shadowColor="#80000000"
            android:shadowRadius="12" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#F2FFFFFF"
                android:textSize="132sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 200"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false"
                android:shadowColor="#66000000"
                android:shadowRadius="24" />

            <TextClock
                android:id="@+id/dreamAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#B3FFFFFF"
                android:textSize="24sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#D9FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:shadowColor="#80000000"
                android:shadowRadius="12" />

            <TextView
                android:id="@+id/dreamWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D9FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.06"
                android:shadowColor="#80000000"
                android:shadowRadius="12" />
        </LinearLayout>

        <TextView
            android:id="@+id/dreamPlaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:maxWidth="560dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#E6FFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:shadowColor="#80000000"
            android:shadowRadius="12"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
