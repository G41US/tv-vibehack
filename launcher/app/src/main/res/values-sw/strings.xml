    <string name="ss_hero">Hakuna haja ya simu</string>
    <string name="ss_hero_line">Washa mipangilio miwili kwa rimoti, kisha bonyeza Weka kila kitu. TV Home itafanya yaliyobaki yenyewe.</string>
    <string name="ss_step_dev">1. Washa Chaguo za wasanidi programu</string>
    <string name="ss_step_dev_value">Kuhusu → bonyeza OK mara 7 kwenye toleo</string>
    <string name="ss_step_debug">2. Washa utatuzi wa USB</string>
    <string name="ss_debug_on">Imewashwa</string>
    <string name="ss_debug_off">Chaguo za wasanidi programu → Utatuzi wa USB</string>
    <string name="ss_step_go">3. Weka kila kitu</string>
    <string name="ss_go_ready">Tayari</string>
    <string name="ss_go_wait">Baada ya hatua 1 na 2</string>
    <string name="ss_manual">Fungua Mipangilio kwa rimoti: Mfumo (au Mapendeleo ya kifaa) → Kuhusu → bonyeza OK mara 7 kwenye \"Toleo la Android TV OS\" (au \"Toleo\"). Kisha rudi Mfumo → Chaguo za wasanidi programu → washa utatuzi wa USB (kwenye TV nyingine: utatuzi wa mtandao au ADB).</string>
    <string name="ss_connecting">Inaunganisha na TV hii…</string>
    <string name="ss_allow">TV yako inauliza \"Ruhusu utatuzi wa USB?\". Weka alama kwenye \"Ruhusu kila wakati\", kisha uchague Sawa.</string>
    <string name="ss_working">Inaweka…</string>
    <string name="ss_err_off">Utatuzi wa USB bado haujawashwa, au TV hii inauruhusu tu kupitia kebo. Uwashe kwenye Chaguo za wasanidi programu (TV nyingine huuita utatuzi wa mtandao au ADB), kisha ujaribu tena.</string>
    <string name="ss_err_timeout">Swali la TV halikujibiwa. Jaribu tena, na uchague Sawa inapouliza \"Ruhusu utatuzi wa USB?\".</string>
